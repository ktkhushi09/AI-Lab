import random
N = 4
def calculate_cost(board):
    cost = 0
    for i in range(N):
        for j in range(i + 1, N):
            if board[i] == board[j] or abs(board[i] - board[j]) == abs(i - j):
                cost += 1
    return cost
def hill_climbing():
    board = [random.randint(0, N - 1) for _ in range(N)]
    while True:
        current_cost = calculate_cost(board)
        print("Board:", board, "Cost:", current_cost)
        if current_cost == 0:
            print("Solution Found!")
            return
        best_board = board[:]
        best_cost = current_cost
        for col in range(N):
            for row in range(N):
                if row == board[col]:
                    continue
                neighbour = board[:]
                neighbour[col] = row
                cost = calculate_cost(neighbour)
                if cost < best_cost:
                    best_cost = cost
                    best_board = neighbour
        if best_cost >= current_cost:
            print("Local Minimum Reached!")
            return
        board = best_board
hill_climbing()
