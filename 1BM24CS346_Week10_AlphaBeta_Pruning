tree = [
    [[10, 9], [14, 18]],
    [[5, 4], [50, 3]]
]
pruned = []
def alphabeta(node, depth, alpha, beta, maximizing, path="Root"):
    if isinstance(node, int):
        return node
    if maximizing:
        best = float('-inf')
        for i, child in enumerate(node):
            value = alphabeta(
                child, depth + 1,
                alpha, beta, False,
                path + f"->{i}"
            )
            best = max(best, value)
            alpha = max(alpha, best)
            if beta <= alpha:
                for j in range(i + 1, len(node)):
                    pruned.append(node[j])
                break
        return best
    else:
        best = float('inf')
        for i, child in enumerate(node):
            value = alphabeta(
                child, depth + 1,
                alpha, beta, True,
                path + f"->{i}"
            )
            best = min(best, value)
            beta = min(beta, best)
            if beta <= alpha:
                for j in range(i + 1, len(node)):
                    pruned.append(node[j])
                break
        return best
result = alphabeta(
    tree, 0,
    float('-inf'),
    float('inf'),
    True
)
print("Optimal value of root node:", result)
print("Pruned subtrees:", pruned)
