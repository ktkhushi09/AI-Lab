#DFS
start = (1,2,3,
         0,4,6,
         7,5,8)
goal  = (1,2,3,
         4,5,6,
         7,8,0)
def moves(s):
    b=s.index(0)
    out=[]
    for d in (-3,3,-1,1):
        n=b+d
        if n<0 or n>8:
            continue
        if d==-1 and b%3==0:
            continue
        if d==1 and b%3==2:
            continue
        t=list(s)
        t[b],t[n]=t[n],t[b]
        out.append(tuple(t))
    return out
def show(s):
    for i in (0,3,6):
        print(s[i:i+3])
    print()
def dfs():
    stack=[start]
    parent={start:None}
    while stack:
        s=stack.pop()
        if s==goal:
            break
        for n in moves(s):
            if n not in parent:
                parent[n] = s
                stack.append(n)
    path=[]
    while s:
        path.append(s)
        s=parent[s]
    return path[::-1]
dfs_solution=dfs()
total=len(dfs_solution)-1
print("DFS moves:", total)
print("\nDFS first 2 moves:")
for i in (1,2):
    print("Step", i)
    show(dfs_solution[i])
print("DFS last 2 moves:")
for i in (total-1,total):
    print("Step", i)
    show(dfs_solution[i])

#IDS
start=(1, 2, 3,
       0, 4, 6,
       7, 5, 8)
goal=(1, 2, 3,
      4, 5, 6,
      7, 8, 0)
def show(s):
    for i in (0,3,6):
        print(s[i:i+3])
    print()
def dls(s,limit,path):
    if s==goal:
        return path
    if limit==0:
        return None
    for n in moves(s):
        if n not in path:
            r=dls(n,limit-1,path+[n])
            if r:
                return r
    return None
def ids():
    for depth in range(50):
        r=dls(start,depth,[start])
        if r:
            return r
ids_solution=ids()
print("IDS moves:",len(ids_solution)-1)
print("\nIDS Solution:")
for s in ids_solution:
    show(s)
